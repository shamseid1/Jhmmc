{
  "appId": "com.africasportfishing.app",
  "appName": "Africa Sportfishing",
  "webDir": "www",
  "server": {
    "url": "https://africasportfishing.com",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#f4f6fa"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  },
  "ios": {
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#f4f6fa"
  }
}
